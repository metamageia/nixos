    requires = [
      "docker-network-servarr_default.service"
    ];
    partOf = [
      "docker-compose-servarr-root.target"
    ];
    wantedBy = [
      "docker-compose-servarr-root.target"
    ];
  };
  virtualisation.oci-containers.containers."qbittorrent" = {
    image = "lscr.io/linuxserver/qbittorrent:latest";
    environment = {
      "PGID" = "100";
      "PUID" = "1000";
      "TZ" = "America/Chicago";
    };
    volumes = [
      "/srv/downloads:/downloads:rw"
      "/srv/servarr/qbittorrent/config:/config:rw"
    ];
    ports = [
      "8080:8080/tcp"
      "6881:6881/tcp"
