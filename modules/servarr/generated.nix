      "PUID" = "1000";
      "TZ" = "America/Chicago";
    };
    volumes = [
      "/srv/downloads:/downloads:rw"
      "/srv/media/Movies:/movies:rw"
      "/srv/servarr/radarr/config:/config:rw"
    ];
