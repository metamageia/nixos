    ];
  };
  virtualisation.oci-containers.containers."sonarr" = {
    image = "lscr.io/linuxserver/sonarr:latest";
    environment = {
      "PGID" = "100";
      "PUID" = "1000";
      "TZ" = "America/Chicago";
    };
    volumes = [
      "/srv/downloads:/downloads:rw"
      "/srv/media/TV:/tv:rw"
